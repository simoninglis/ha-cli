#!/usr/bin/env bash
# Convenience wrapper for ha-automation-cli

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Check if poetry is installed
if command -v poetry &> /dev/null; then
    cd "$SCRIPT_DIR" && poetry run ha-automation "$@"
else
    echo "Poetry not found. Please install poetry or run: python -m ha_automation" >&2
    exit 1
fi