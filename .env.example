# Home Assistant Configuration
# Copy this file to .env and fill in your values

# Your Home Assistant URL (include protocol and port)
HOME_ASSISTANT_URL=http://homeassistant.local:8123

# Your Home Assistant Long-Lived Access Token
# Generate one from: Profile -> Security -> Long-Lived Access Tokens
HOME_ASSISTANT_TOKEN=your-token-here

# Alternative environment variable names (for backward compatibility)
# These will automatically use the values from above
HA_URL=${HOME_ASSISTANT_URL}
HA_TOKEN=${HOME_ASSISTANT_TOKEN}

# SSH configuration (for system logs/config commands)
# HA_SSH_HOST=homeassistant
# HA_SSH_USER=root

# For dashboard screenshots (requires local auth)
# HA_USERNAME=your-username
# HA_PASSWORD=your-password

# For entity analysis file links (File Editor addon)
# HA_FILE_EDITOR_URL=http://homeassistant.local:8123/api/hassio_ingress/<ingress_id>