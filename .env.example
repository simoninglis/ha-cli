# Home Assistant Configuration
# Copy this file to .env and fill in your values. Non-secret settings only:
# ha-cli ignores any HA_TOKEN / HOME_ASSISTANT_TOKEN in this file (tokens come from
# the environment, e.g. injected by bao-run).

# Your Home Assistant URL (include protocol and port)
HA_URL=http://homeassistant.local:8123

# SSH configuration (for system logs/config commands)
# HA_SSH_HOST=homeassistant
# HA_SSH_USER=root

# Dashboard screenshots / smoke tests log in with HA_TOKEN. Without a token they
# fall back to the HA login:
# HA_USERNAME=your-username
# HA_PASSWORD=your-password

# For entity analysis file links (File Editor addon)
# HA_FILE_EDITOR_URL=http://homeassistant.local:8123/api/hassio_ingress/<ingress_id>
