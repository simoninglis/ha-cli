# Home Assistant Configuration
# Copy this file to .env and fill in your values

# Your Home Assistant URL (include protocol and port)
HOME_ASSISTANT_URL=http://homeassistant.local:8123

# Your Home Assistant Long-Lived Access Token
# Generate one from: Profile -> Security -> Long-Lived Access Tokens
HOME_ASSISTANT_TOKEN=your-token-here

# Alternative environment variable names (for backward compatibility)
# These will automatically use the values from above
HA_URL=${HOME_ASSISTANT_URL}
HA_TOKEN=${HOME_ASSISTANT_TOKEN}

# WebSocket URL (optional, will be derived from HOME_ASSISTANT_URL if not set)
# HOME_ASSISTANT_WEB_SOCKET_URL=ws://homeassistant.local:8123/api/websocket